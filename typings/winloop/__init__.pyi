import asyncio

from collections.abc import Callable, Coroutine
from typing import Any

__version__: str

# The methods of asyncio that Loop implements, which typeshed has abstract in asyncio.AbstractEventLoop
class Loop(asyncio.AbstractEventLoop):
    slow_callback_duration: float
    def run_forever(self) -> None: ...
    def stop(self) -> None: ...
    def is_running(self) -> bool: ...
    def call_soon(self, callback: Callable[..., object], *args: Any, context: Any = None) -> asyncio.Handle: ...
    def add_reader(self, fd: Any, callback: Callable[..., Any], *args: Any) -> None: ...
    def add_writer(self, fd: Any, callback: Callable[..., Any], *args: Any) -> None: ...
    def _asyncgen_finalizer_hook(self, agen: Any) -> None: ...

def new_event_loop() -> Loop: ...
def run[T](
    main: Coroutine[Any, Any, T],
    *,
    loop_factory: Callable[[], Loop] | None = ...,
    debug: bool | None = None,
) -> T: ...
